{% comment %}
  News list (customized): shows news items AND blog posts together, newest first.
  - Blog posts in the "life" category are labelled "Life beyond the lab".
  - Other blog posts are labelled "New blog post".
  - New papers: add a one-line item in the _news folder (see 更新指南.md).
{% endcomment %}
<div class="news">
  {% assign all_items = site.news | concat: site.posts | sort: 'date' | reverse %}
  {% assign items_size = all_items | size %}
  {% if items_size > 0 %}
    <div class="table-responsive">
      <table class="table table-sm table-borderless">
        {% if include.limit and page.announcements.limit %}
          {% assign news_limit = page.announcements.limit %}
        {% else %}
          {% assign news_limit = items_size %}
        {% endif %}
        {% for item in all_items limit: news_limit %}
          <tr>
            <th scope="row" style="width: 20%">{{ item.date | date: '%b %d, %Y' }}</th>
            <td>
              {% if item.collection == 'posts' %}
                {% if item.categories contains 'life' %}Life beyond the lab:{% else %}New blog post:{% endif %}
                <a class="news-title" href="{{ item.url | relative_url }}">{{ item.title }}</a>
              {% elsif item.inline %}
                {{ item.content | remove: '<p>' | remove: '</p>' | emojify }}
              {% else %}
                <a class="news-title" href="{{ item.url | relative_url }}">{{ item.title }}</a>
              {% endif %}
            </td>
          </tr>
        {% endfor %}
      </table>
    </div>
  {% else %}
    <p>No news so far...</p>
  {% endif %}
</div>
